# Copy values into your shell or tooling; never commit a real credential.
# These match docker-compose.yml, which is LOCAL DEVELOPMENT ONLY. The integration tests use them
# as defaults when none of the four is set, so you only export these for a different Postgres.

# The owner role: runs `bun run db:migrate`, `bun run db:generate` and the integration tests' setup.
DATABASE_URL=postgres://closeline_owner:closeline_owner_local@127.0.0.1:5432/closeline

# One login per service, used by the integration tests to prove what each role can reach.
DATABASE_URL_AUTH=postgres://closeline_auth:closeline_auth_local@127.0.0.1:5432/closeline
DATABASE_URL_CORE=postgres://closeline_core:closeline_core_local@127.0.0.1:5432/closeline
DATABASE_URL_PLAYBOOK=postgres://closeline_playbook:closeline_playbook_local@127.0.0.1:5432/closeline
DATABASE_URL_VOICE=postgres://closeline_voice:closeline_voice_local@127.0.0.1:5432/closeline
DATABASE_URL_OUTBOUND=postgres://closeline_outbound:closeline_outbound_local@127.0.0.1:5432/closeline

# No login for closeline_core_search: it is a NOLOGIN, BYPASSRLS role that owns the Prospect search
# functions (migration 0030). docker/postgres/init.sql creates it locally; a deployed Region must
# create it (NOLOGIN BYPASSRLS, granted to closeline_owner WITH SET TRUE, INHERIT FALSE) before the
# migration runs. See the README.
